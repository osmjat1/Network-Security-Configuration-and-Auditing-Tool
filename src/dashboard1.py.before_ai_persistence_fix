    st.markdown("### Local AI Security Analysis")
    st.caption(
        "Uses Ollama on this machine to explain the current audit findings. "
        "AI output is advisory; the deterministic audit remains the source of truth."
    )

    st.info(
        "Review all suggestions before making changes. "
        "This page does not apply configuration changes to network devices."
    )

    st.write(f"**Audit source:** {source_config}")
