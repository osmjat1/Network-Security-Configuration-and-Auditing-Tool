def risk_color(score):
    if score >= 70:
        return "#EF4444", "CRITICAL"
    if score >= 40:
        return "#F97316", "HIGH"
    if score >= 20:
        return "#EAB308", "MODERATE"
    return "#22C55E", "LOW"


