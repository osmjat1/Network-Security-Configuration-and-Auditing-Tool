    if not findings:
        st.warning("The selected report contains no findings to analyze.")
    else:
        if st.button("Run local AI analysis", type="primary"):
            # Clear old output so a failed run cannot look like a fresh result.
            st.session_state.pop("netsecureops_ai_analysis", None)
            st.session_state.pop("netsecureops_ai_report_source", None)

            with st.spinner("Ollama is analyzing the audit. This may take several minutes..."):
                try:
                    try:
                        from src.ai_analyst import analyze_findings
                    except ModuleNotFoundError:
                        from ai_analyst import analyze_findings

                    analysis = analyze_findings(report, timeout=300)

                    # Persist the latest AI analysis for reuse and evidence.
                    ai_report_path = ROOT / "reports" / "ai_analysis.md"
                    ai_report_path.parent.mkdir(parents=True, exist_ok=True)
                    ai_report_path.write_text(
                        analysis.rstrip() + "\n",
                        encoding="utf-8",
                    )

                    st.session_state["netsecureops_ai_analysis"] = analysis
                    st.session_state["netsecureops_ai_report_source"] = str(source_config)
                except (RuntimeError, ValueError, OSError) as exc:
                    st.error(f"AI analysis failed: {exc}")

        saved_analysis = st.session_state.get("netsecureops_ai_analysis")
        saved_source = st.session_state.get("netsecureops_ai_report_source")

        if saved_analysis:
            st.markdown("#### AI analysis")
            st.caption(
                "Generated locally. Check recommendations against the actual "
                "configuration and your network policy."
            )
            st.markdown(saved_analysis)

            st.download_button(
                "Download AI analysis",
                data=saved_analysis,
                file_name="netsecureops_ai_analysis.txt",
                mime="text/plain",
            )
        else:
            st.caption("Select Run local AI analysis to generate the analysis.")

