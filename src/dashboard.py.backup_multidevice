SEVERITY_COLORS = {
    "Critical": "#EF4444", "High": "#F97316", "Medium": "#EAB308",
    "Low": "#38BDF8", "Info": "#A78BFA", "Informational": "#A78BFA",
    "Unknown": "#94A3B8",
}
ALLOWED_EXTENSIONS = {".txt", ".cfg", ".conf"}


def load_report():
    if not REPORT.is_file():
        return None
    try:
        return json.loads(REPORT.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None


def list_configs():
    """Return project-local supported configs, newest uploads first."""
    configs = []
    if DEFAULT_CONFIG.is_file():
        configs.append(DEFAULT_CONFIG)
    if UPLOAD_DIR.is_dir():
        uploads = [
            p for p in UPLOAD_DIR.iterdir()
            if p.is_file() and p.suffix.lower() in ALLOWED_EXTENSIONS
        ]
        uploads.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        configs.extend(uploads)
    return configs


def run_audit(config_path: Path):
    """Run the existing offline auditor on the selected config and preserve history."""
    config_path = Path(config_path).resolve()
    project_root = ROOT.resolve()

    try:
        config_path.relative_to(project_root)
    except ValueError:
        return False, "For safety, audit only configuration files inside NetSecureOps."

    if not config_path.is_file():
        return False, "Selected configuration file was not found."
    if config_path.suffix.lower() not in ALLOWED_EXTENSIONS:
        return False, "Unsupported file type. Use .txt, .cfg, or .conf."
    if not AUDITOR.is_file():
        return False, "Auditor script was not found."

    audit_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    run_dir = HISTORY_DIR / f"audit_{audit_id}"
    run_dir.mkdir(parents=True, exist_ok=False)

    try:
        result = subprocess.run(
            [
                sys.executable, str(AUDITOR), str(config_path),
                "--out", str(run_dir),
            ],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"Could not run audit: {exc}"

    if result.returncode != 0:
        details = result.stderr.strip() or result.stdout.strip() or "Audit failed."
        return False, details

    run_report_path = run_dir / "audit_report.json"
    run_csv_path = run_dir / "findings.csv"
    if not run_report_path.is_file():
        return False, "Auditor did not create audit_report.json in the history folder."

    try:
        report_data = json.loads(run_report_path.read_text(encoding="utf-8"))
        report_data["source_config"] = str(config_path.relative_to(project_root))
        report_data["audit_id"] = audit_id
        # Write source metadata into this audit's own report.
        run_report_path.write_text(json.dumps(report_data, indent=2), encoding="utf-8")

        REPORT.parent.mkdir(parents=True, exist_ok=True)
        REPORT.write_text(json.dumps(report_data, indent=2), encoding="utf-8")

        # Also keep a top-level CSV copy for easy browsing.
        if run_csv_path.is_file():
            (HISTORY_DIR / f"findings_{audit_id}.csv").write_bytes(run_csv_path.read_bytes())
    except (OSError, json.JSONDecodeError) as exc:
        return False, f"Audit ran, but saving the report failed: {exc}"

    return True, f"Audit completed for {config_path.name}. History ID: {audit_id}"


def card(label, value, subtitle="", color="#F8FAFC"):
    st.markdown(
        f"""
        <div class="ns-card">
          <div class="ns-label">{label}</div>
          <div class="ns-value" style="color:{color}">{value}</div>
          <div class="ns-sub">{subtitle}</div>
        </div>
        """,
        unsafe_allow_html=True,
    )


def risk_color(score):
    if score >= 70:
        return "#EF4444", "CRITICAL"
    if score >= 40:
        return "#F97316", "HIGH"
    if score >= 20:
        return "#EAB308", "MODERATE"
    return "#22C55E", "LOW"


