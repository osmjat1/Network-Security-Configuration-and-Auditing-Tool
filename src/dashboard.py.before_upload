}

def load_report():
    if not REPORT.exists():
        return None
    try:
        return json.loads(REPORT.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None

def run_audit():
    if not CONFIG.exists():
        return False, "Sample configuration file was not found."
    if not AUDITOR.exists():
        return False, "Auditor script was not found."

    try:
        result = subprocess.run(
            [sys.executable, str(AUDITOR), str(CONFIG)],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)

    if result.returncode != 0:
        return False, result.stderr or result.stdout or "Audit failed."

    if not REPORT.exists():
        return False, "Auditor finished but did not create the expected JSON report."

    return True, "Audit completed successfully."

def card(label, value, subtitle="", color="#F8FAFC"):
    st.markdown(
        f"""
        <div class="ns-card">
          <div class="ns-label">{label}</div>
          <div class="ns-value" style="color:{color}">{value}</div>
          <div class="ns-sub">{subtitle}</div>
        </div>
        """,
        unsafe_allow_html=True,
    )

def risk_color(score):
    if score >= 70:
        return "#EF4444", "CRITICAL"
    if score >= 40:
        return "#F97316", "HIGH"
    if score >= 20:
        return "#EAB308", "MODERATE"
    return "#22C55E", "LOW"

